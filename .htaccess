<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # The project root is the web root here, so only files inside public/ (build assets,
    # storage link, images) and the favicon/robots are served directly. Everything else —
    # including .env, .git, storage/, vendor/ — goes through Laravel and is never exposed.
    RewriteRule ^public/ - [L]
    RewriteRule ^(favicon\.ico|robots\.txt)$ - [L]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteRule ^ index.php [L]
</IfModule>

# No folder listings anywhere (not only when mod_negotiation is loaded).
Options -Indexes

# Belt and braces when mod_rewrite is off: never serve dotfiles, dumps, archives, logs or project files.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "(?i)\.(sql|zip|gz|tar|tgz|rar|7z|bak|old|log|sqlite|env|lock|ini|ya?ml|md|dist|xml)$">
    Require all denied
</FilesMatch>
<IfModule !mod_rewrite.c>
    RedirectMatch 404 "^(?!.*/public/).*/(app|bootstrap|config|database|node_modules|resources|routes|storage|tests|vendor)/"
</IfModule>
